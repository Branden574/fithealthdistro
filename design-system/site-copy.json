    { "key": "catalog.filter.label", "page": "Catalog", "section": "Filters", "label": "Filter group, for screen readers", "text": "Filter by category", "max": 40 },
    { "key": "catalog.card.added.announce", "page": "Catalog", "section": "Product card", "label": "Added, for screen readers", "text": "{name} is in your request.", "max": 80, "hint": "{name} is replaced with the product name." },
    { "key": "catalog.card.removed.announce", "page": "Catalog", "section": "Product card", "label": "Removed, for screen readers", "text": "{name} is out of your request.", "max": 80, "hint": "{name} is replaced with the product name." },
