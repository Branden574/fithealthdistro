    { "key": "nav.contact", "page": "All pages", "section": "Navigation", "label": "Contact link", "text": "Contact", "max": 16 },
    { "key": "nav.faq", "page": "All pages", "section": "Navigation", "label": "FAQ link", "text": "FAQ", "max": 16, "hint": "Shown only while at least one question is published." },
    { "key": "nav.menu.open", "page": "All pages", "section": "Navigation", "label": "Open menu, for screen readers", "text": "Open menu", "max": 24 },
    { "key": "nav.menu.close", "page": "All pages", "section": "Navigation", "label": "Close menu, for screen readers", "text": "Close menu", "max": 24 },
    { "key": "a11y.skip", "page": "All pages", "section": "Navigation", "label": "Skip link", "text": "Skip to content", "max": 32, "hint": "The first thing a keyboard reaches on every page." },
    { "key": "meta.title", "page": "All pages", "section": "Search results", "label": "Site title", "text": "Fit Health Distribution", "max": 60, "hint": "Shown in the browser tab and in search results." },
    { "key": "meta.description", "page": "All pages", "section": "Search results", "label": "Site description", "text": "Vending machines, fitness supplements and drinks. Tell us what you need and we will send you a quote.", "max": 160, "multiline": true, "hint": "The line under the title in search results." },

    { "key": "home.hero.eyebrow", "page": "Home", "section": "Hero", "label": "Eyebrow", "text": "Fit Health Distribution", "max": 40 },
    { "key": "home.hero.headline", "page": "Home", "section": "Hero", "label": "Headline", "text": "Stock what moves.", "max": 28, "hint": "Shown in capitals. Keep it to two or three words a line." },
    { "key": "home.hero.highlight", "page": "Home", "section": "Hero", "label": "Highlighted words", "text": "moves.", "max": 14, "hint": "The part of the headline that takes the volt highlighter. It has to match the headline exactly. Leave it empty for none.", "optional": true },
    { "key": "home.hero.lead", "page": "Home", "section": "Hero", "label": "Intro paragraph", "text": "Vending machines, fitness supplements and drinks. Tell us what you need and we will send you a quote.", "max": 160, "multiline": true },
    { "key": "home.hero.primary", "page": "Home", "section": "Hero", "label": "Main button", "text": "Request a quote", "max": 22 },
