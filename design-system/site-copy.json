    { "key": "contact.form.phone", "page": "Contact", "section": "Form", "label": "Phone label", "text": "Phone", "max": 24 },
    { "key": "contact.form.interest", "page": "Contact", "section": "Form", "label": "Interest label", "text": "I am interested in", "max": 32 },
    { "key": "contact.form.interest.placeholder", "page": "Contact", "section": "Form", "label": "Interest placeholder", "text": "Choose one", "max": 24 },
    { "key": "contact.form.message", "page": "Contact", "section": "Form", "label": "Message label", "text": "Message", "max": 24 },
