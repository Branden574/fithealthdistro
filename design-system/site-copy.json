    { "key": "contact.error.phone", "page": "Contact", "section": "Errors", "label": "Phone wrong", "text": "Enter a phone number, or leave it empty.", "max": 80 },
    { "key": "contact.error.interest", "page": "Contact", "section": "Errors", "label": "Interest missing", "text": "Choose what you are interested in.", "max": 80 },
