# Copy to .env.local and fill in. Never commit real values.
# Local development: run `npm run db:start`, then take the values from `supabase status -o env`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY).

# Supabase project URL and publishable key. Public by design: they are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only: bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Random string used to hash visitor IP addresses for rate limiting (for example `openssl rand -hex 24`).
RATE_LIMIT_SALT=
