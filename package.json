{
  "name": "fithealthdistro",
  "version": "0.1.0",
  "private": true,
  "description": "Fit Health Distribution storefront and admin.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ds:build": "npm run build -w design-system",
    "ds:check": "npm run check -w design-system",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:sync-copy",
    "db:test": "supabase test db",
    "db:advisors": "supabase db advisors --local --fail-on warn",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:sync-copy": "node scripts/db/sync-site-copy.mjs",
    "db:allow-admin": "node scripts/db/allow-admin.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "design-system"
  ]
}
